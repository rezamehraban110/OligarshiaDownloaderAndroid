+    fun importCookies(context: Context, uri: Uri): Result<Unit> = runCatching {
+        val target = File(context.filesDir, COOKIE_FILE)
+        val temp = File(context.cacheDir, "youtube_cookies_import.tmp")
+        context.contentResolver.openInputStream(uri)?.use { input ->
+            temp.outputStream().use { output -> input.copyTo(output) }
+        } ?: error("فایل cookies.txt قابل خواندن نیست.")
+
+        if (temp.length() <= 0) error("فایل cookies.txt خالی است.")
+        val sample = temp.inputStream().bufferedReader().use { reader ->
+            buildString {
+                repeat(80) {
+                    val line = reader.readLine() ?: return@repeat
+                    append(line).append('\n')
+                }
+            }
+        }
+        val looksValid = sample.contains("Netscape HTTP Cookie File", ignoreCase = true) ||
+            sample.lineSequence().any { it.count { ch -> ch == '\t' } >= 6 }
+        if (!looksValid) error("فرمت فایل معتبر نیست. فایل Netscape cookies.txt را انتخاب کنید.")
+
+        if (!temp.renameTo(target)) {
+            temp.copyTo(target, overwrite = true)
+            temp.delete()
+        }
+        target.setReadable(false, false)
+        target.setReadable(true, true)
+        target.setWritable(false, false)
+        target.setWritable(true, true)
+
+        val displayName = uri.lastPathSegment?.substringAfterLast('/')?.takeIf { it.isNotBlank() } ?: "cookies.txt"
+        context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+            .edit().putString(KEY_COOKIE_NAME, displayName).apply()
+        _cookieName.value = displayName
+        _cookiesConfigured.value = true
+    }
+
+    fun clearCookies(context: Context) {
+        runCatching { File(context.filesDir, COOKIE_FILE).delete() }
+        context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+            .edit().remove(KEY_COOKIE_NAME).apply()
+        _cookieName.value = null
+        _cookiesConfigured.value = false
+    }
+
